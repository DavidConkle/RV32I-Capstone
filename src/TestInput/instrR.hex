// ====== R-type (register-register ALU) test: 19 instructions ======
//
// Expected final register values (registers not listed are unchanged):
//   x1  = 0xF2345678
//   x2  = 0x07654FED
//   x3  = 0x00000004
//   x4  = 0xF999A665
//   x5  = 0xEACF068B
//   x6  = 0x7654FED0
//   x7  = 0x00000001
//   x8  = 0x00000000
//   x9  = 0xF5511995
//   x10 = 0x0F234567
//   x11 = 0xFF234567
//   x12 = 0xF7755FFD
//   x13 = 0x02244668
//
//
F23450B7 // lui x1, 0xF2345        : x1 = 0xF2345 << 12 -> x1 = 0xF2345000
07655137 // lui x2, 0x07655        : x2 = 0x07655 << 12 -> x2 = 0x07655000
67808093 // addi x1, x1, 1656      : x1 = x1 + 1656 -> x1 = 0xF2345678
FED10113 // addi x2, x2, -19       : x2 = x2 + -19 -> x2 = 0x07654FED
00400193 // addi x3, x0, 4         : x3 = x0 + 4 -> x3 = 0x00000004
00311333 // sll x6, x2, x3         : x6 = x2 << x3 (low 5 bits) -> x6 = 0x7654FED0
0030D533 // srl x10, x1, x3        : x10 = x1 >> x3 (logical) -> x10 = 0x0F234567
00208233 // add x4, x1, x2         : x4 = x1 + x2 -> x4 = 0xF999A665
402082B3 // sub x5, x1, x2         : x5 = x1 - x2 -> x5 = 0xEACF068B
0020A3B3 // slt x7, x1, x2         : x7 = (x1 < x2) signed ? 1 : 0 -> x7 = 0x00000001
0020B433 // sltu x8, x1, x2        : x8 = (x1 < x2) unsigned ? 1 : 0 -> x8 = 0x00000000
0020C4B3 // xor x9, x1, x2         : x9 = x1 ^ x2 -> x9 = 0xF5511995
4030D5B3 // sra x11, x1, x3        : x11 = x1 >> x3 (arithmetic) -> x11 = 0xFF234567
0020E633 // or x12, x1, x2         : x12 = x1 | x2 -> x12 = 0xF7755FFD
0020F6B3 // and x13, x1, x2        : x13 = x1 & x2 -> x13 = 0x02244668
00000013 // nop                    : nop: no operation (keeps the pipeline draining)
00000013 // nop                    : nop: no operation (keeps the pipeline draining)
00000013 // nop                    : nop: no operation (keeps the pipeline draining)
00000013 // nop                    : nop: no operation (keeps the pipeline draining)
